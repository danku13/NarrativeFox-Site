# SQLite-база для заявок с формы (Prisma).
# Путь относительно prisma/schema.prisma.
DATABASE_URL="file:../db/custom.db"

# Статическая сборка для GitHub Pages (см. README, «Деплой на GitHub Pages»).
# В воркфлоу .github/workflows/deploy-pages.yml эти переменные ставятся сам,
# здесь они для локальной проверки статики.
#
# NEXT_OUTPUT=export            # включить режим next output: "export"
# NEXT_PUBLIC_STATIC_EXPORT=1   # форма заявок работает без своего сервера
# NEXT_PUBLIC_LEAD_EMAIL=hello@example.com   # получатель заявок через почтовый клиент
# NEXT_PUBLIC_LEAD_ENDPOINT=https://api.example.com/leads   # внешний приёмник заявок (контракт как у /api/leads)
# NEXT_BASE_PATH=/NarrativeFox-Site   # только для хостинга вида user.github.io/repo
