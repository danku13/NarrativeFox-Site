// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Заявки с посадочной страницы. Единственный защищённый канал связи:
// форма с антиспам-проверкой, без публичной почты и личных контактов.
// Контекст воронки v3.0: контур, роль и точка входа заявки.
model Lead {
  id         String   @id @default(cuid())
  name       String
  contact    String
  message    String
  source     String?  @default("landing")
  // Макро-контур: gateway | solo | business
  contour    String?  @default("gateway")
  // Роль внутри контура: expert | blogger | b2b | tech, пусто если неизвестна
  segment    String?  @default("")
  // Какая кнопка открыла форму: hero_cta, tariff_cta, final_form и другие
  entryPoint String?  @default("final_form")
  createdAt  DateTime @default(now())
}